# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
AUTHORIZED_USERS=123456789,987654321

# OpenCode Configuration
OPENCODE_SERVER_URL=http://localhost:4096
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
OPENCODE_MODEL=opencode/deepseek-v4-flash-free
OPENCODE_WORK_DIR=.

# Limits
MAX_MESSAGE_LENGTH=4000
RESPONSE_TIMEOUT=0  # Set to 0 to disable request timeouts entirely

# Webhook (optional — enables instant message delivery instead of long polling)
# Set WEBHOOK_MODE=true and WEBHOOK_URL to your tunnel's public DNS.
# Optionally set CLOUDFLARE_TUNNEL_TOKEN to let the bot start the tunnel for you.
# Requires cloudflared installed: brew install cloudflared
WEBHOOK_MODE=false
WEBHOOK_PORT=51956
WEBHOOK_URL=
CLOUDFLARE_TUNNEL_TOKEN=

# Database
DB_PATH=sessions.db
